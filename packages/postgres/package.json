{
  "name": "@unknown-planet/postgres",
  "version": "1.0.0",
  "description": "PostgreSQL and pgvector adapters for Unknown Planet.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/HoshimiAI/unknownplanet.git", "directory": "packages/postgres" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "tsc --build --clean tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "migrate": "bun scripts/migrate.ts",
    "lint": "tsc --project tsconfig.json --noEmit",
    "test": "bun test test",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@unknown-planet/core": "^1.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  }
}
