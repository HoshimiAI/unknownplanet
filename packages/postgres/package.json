{
  "name": "@unknown-planet/postgres",
  "version": "0.1.0",
  "description": "PostgreSQL and pgvector adapters for Unknown Planet.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "tsc --build --clean tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "tsc --project tsconfig.json --noEmit",
    "test": "bun test index.test.js",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": { "@unknown-planet/core": "workspace:*", "pg": "^8.16.3" },
  "devDependencies": { "@types/pg": "^8.15.5" }
}
