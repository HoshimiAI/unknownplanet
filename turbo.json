{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["UP_TEST_DATABASE_URL", "UP_TEST_MONGODB_URI", "UP_TEST_NEO4J_URI", "UP_TEST_NEO4J_USER", "UP_TEST_NEO4J_PASSWORD", "UP_TEST_QDRANT_URL", "UP_TEST_QDRANT_API_KEY", "UP_TEST_REDIS_URL", "UP_TEST_MINIO_ENDPOINT", "UP_TEST_MINIO_REGION", "UP_TEST_MINIO_ACCESS_KEY", "UP_TEST_MINIO_SECRET_KEY", "UP_TEST_MINIO_BUCKET"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
